<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- IIS request filtering caps the request body at ~28.6 MB by default. Raise it so large
         document saves (handled by DocumentsController.Save) are not rejected with 404.13. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" /> <!-- 200 MB -->
      </requestFiltering>
    </security>
    <handlers>
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!-- Increase the web server timeout to over 15 minutes -->
    <aspNetCore requestTimeout="00:15:00" processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="InProcess" />

    <!-- Warm up URL -->
    <applicationInitialization>
      <add initializationPage="/api/global-settings/ping" />
    </applicationInitialization>
  </system.webServer>
</configuration>